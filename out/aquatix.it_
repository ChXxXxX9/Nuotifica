							$(".classifica").append("<div class='classifica_div_cat' id=" + key.split(" ").join("_") + " attributo-cat=" + key.split(" ").join("_") + " style='text-align: center'><h3 style='color:#073567; margin-top:20px'>" + key + "</h3></div>");
							// ciclo per strutturare le option della select "stili" nel Modal atleti

							for (var prop in ordered) {
								var battery = ordered[prop];
								var prop_toLower = prop.toLowerCase().trim();
