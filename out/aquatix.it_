<script>
	jQuery(function($) {

		let atleti;

		function showModal() {
			$(".nome").text("");
			$(".nascita").text("");
			$(".tecnico").text("");
			$(".societa").text("");
			$(".stili").text("");
			$("#myModal").show();
		}

		function show_Modal_gare() {
			$(".loader").show();
			$("#myModalGare").show();
			setTimeout(function() {
				$(".loader").hide();
			}, 1200)

		}

		$("#myModal .close").click(function() {

			$(".time_last_race").remove("");
			$(".records_table_result").remove("");
			$(".all_pos_races").text("");
			$(".first_pos_race").text("");
			$('.second_pos_race').text("");
			$('.third_pos_race').text("");
			$("#myModal").hide();
		});


		/*$.get("https://aquatix.it/wp-json/api/v2/nuotatori/", function(result) {
			atleti = result;
			updateAtleti(atleti);
		});*/


		function atlListener(event) {
			//$(".descrizione").append("<button class='accordion' id='accordionDescr' >" + $(event.target).attr('data-descr').substr(0, 20) + "...</button><div class='panel' id='content_descr'>" + $(event.target).attr("data-descr") + "</div>")
			showModal();
			$(".nome").text($(event.target).attr("data-nome"));
			$(".nascita").text($(event.target).attr("data-nascita"));
			$(".society").text($(event.target).attr("data-society"));
			$(".nationality").text($(event.target).attr("data-nationality"));
			$(".profile_pics").attr("src", $(event.target).attr("url-pic"));
			if ($(event.target).attr("data-descr") !== "") {
				$(".descr_athlete").text($(event.target).attr("data-descr"));
			}
			$fincode = $(event.target).attr('data-fincode');


			$.get("https://aquatix.it/wp-json/api/v2/nuotatori/single?fincode=" + $fincode, function(result_atleti) {

				let data = result_atleti.data;


				let all_races = 0;
				var first = 0;
				var second = 0;
				var third = 0;
				let results = data.results;
				let rids = Object.values(data.records);
				let records = results.filter(i => rids.includes(i.id));
				//console.log(records);


				insert_record_table(records);

				for (let index = 0; index < results.length; index++) {
					let position = results[index].ord;

					if (position == '1') {
						first++;
					} else if (position == '2') {
						second++;
					} else if (position == '3') {
						third++;
					}

					$(".table_last_time").append("<tr class='time_last_race'><td>" + results[index].style + "</td><td>" + results[index].time + "</td><td>" + changeFormatDate(results[index].date.substr(0, 10)) + "</td></tr>")



				}
				/* $(".all_pos_races").text(results.length);
				$(".first_pos_race").text(first);
				$('.second_pos_race').text(second);
				$('.third_pos_race').text(third); */

			});

		}

		function insert_record_table(record) {
			for (let y in record) {
				$(".table_record_time").append("<tr class='records_table_result'><td>" + record[y].style + "</td><td>" + record[y].time + "</td><td class='td_with_i' >" + changeFormatDate(record[y].date.substr(0, 10)) + "</td></tr>");
			}

		}




		//Funzione per live Search degli atleti
		$("#myInput").keyup(function() {
			let value = $(this).val();
			$(".atleti div").each(function() {
				let thisDiv = $(this);
				if (thisDiv.attr("attr-nome").indexOf(value.toLowerCase()) !== -1) {

					thisDiv.show();

				} else {

					thisDiv.hide();
				}
			});
		});


		function createAtleta(atleta) {

			let nome_minuscolo = atleta.fullname.toLowerCase();
			let fullname = titleCase(atleta.fullname);
			let $atleta = $('<div class="aquatixatleti large-3 col" style="text-align:center" attr-nome="' + nome_minuscolo + '" ></div>');
			let $link = $('<a href="#" data-id="' + atleta.fincode + '" ><img class="img_box_atleta" data-nationality="' + atleta.nat + '" data-fincode="' + atleta.fincode + '" data-descr="' + atleta.descrizione + '" data-society="' + atleta.team + '" data-nascita="' + atleta.year + '" data-nome="' + atleta.fullname + '"url-pic="' + atleta.image + '" style="width:auto" src="' + atleta.image + '"><h4 class="nome_box_atleta" style="margin:0 auto; color: white; background-color:#073567; box-shadow: 5px 5px 10px #73567;">' + fullname + '</h4></a>');
			$link.click(atlListener);
			$atleta.append($link);

			return $atleta;

		}



		function updateAtleti(atleti) {

			$(".atleti div.aquatixatleti").remove();
			$("#loader_atleti").hide();
			for (const i in atleti) {

				const $atleta = createAtleta(atleti[i]);
				$(".atleti").append($atleta);

			}

			//live_search();
		}


		setTimeout(() => {

			$(".aquatixgare").each(function() {

