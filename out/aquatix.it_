								$("#" + key.split(" ").join("_")).append('<div class="classifica_div" data-stiles=' + prop_replace + '><button class="accordion">' + prop + '</button><div class="panel" id=' + prop_replace + key.split(" ").join("_") + '></div></div>');
								//console.log(prop + " = " + obj[prop]);
