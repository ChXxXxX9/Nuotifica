								for (index in battery) {
									$("#" + prop_replace + key.split(" ").join("_")).append("<strong>Batteria #" + index + "</strong><table id='line_" + index + "_" + prop_replace + key.split(" ").join("_") + "'><tr ><th>Nome</th><th>Anno</th><th>Naz.</th><th>Tempo</th></tr></table>")
									var athletes = battery[index];
									for (athlete of athletes) {
										var intertempi = athlete.MemFields;

										$("#line_" + index + "_" + prop_replace + key.split(" ").join("_")).append("<tr id=" + athlete.ord + athlete.athlete.lastname + athlete.athlete.firstname + " onclick='openIntertempi(this.id)' style='cursor: pointer'><td>" + athlete.ord + ". " + athlete.athlete.firstname + " " + athlete.athlete.lastname + "</td><td>" + athlete.athlete.year + "</td><td>" + athlete.athlete.nat + "</td><td>" + athlete.time + "</td></tr><tr style='display:none;' class='intertempi_div" + athlete.ord + athlete.athlete.lastname + athlete.athlete.firstname + "'><td style='text-align:center;width: 48px'><img src='https://aquatix.it/wp-content/uploads/2020/03/code-working-outline.png' style='width:20px; height: 20px' /></td><td style='text-align:center;width: 48px' ><img src='https://aquatix.it/wp-content/uploads/2020/03/stopwatch-outline.png' style='width: 20px; height: 20px' /></td><td style='text-align:center;width: 48px'><img src='https://aquatix.it/wp-content/uploads/2020/03/time-outline.png' style='width: 20px; height: 20px' /></td></tr>");
										for (let index_intertempi = 0; index_intertempi < intertempi.length; index_intertempi++) {
											if (intertempi[index_intertempi].V !== "") {
												if (intertempi[index_intertempi].T == "") {
													intertempi[index_intertempi].T = intertempi[index_intertempi].V;
												}
												let vasca_intertempo;
												if(intertempi[index_intertempi].M == "FINISH" || intertempi[index_intertempi].M === "ARRIVO"){
													if(prop.indexOf('x') === 1){
														let int_all = prop.split('x');
														let int_1 = int_all[0];
														let int_2 = int_all[1];
														vasca_intertempo = parseInt(int_1) * parseInt(int_2) +"m";
													}else{
														let intertempo_simply = prop.split(' ')[0];
														vasca_intertempo = intertempo_simply + "m";
													}
												}else{
													vasca_intertempo = intertempi[index_intertempi].M;
												}
												$("#line_" + index + "_" + prop_replace + key.split(" ").join("_")).append("<tr class='intertempi_div" + athlete.ord + athlete.athlete.lastname + athlete.athlete.firstname + "' style='display:none; font-size: 14px'><td style='text-align:center; width: 48px'><strong>" + vasca_intertempo + "</strong></td><td style='text-align:center; width: 48px'><strong>" + intertempi[index_intertempi].T + "</strong></td><td style='text-align:center; width: 48px'><strong>" + intertempi[index_intertempi].V + "</strong></td></tr>")
											}
										}
										var piscina_competizione = athlete.event.pool;
									}

								}

							}

						}

						uniqueNames.sort(sortStyles);
						for (let i_unique = 0; i_unique < uniqueNames.length; i_unique++) {
							var index_uniqueLower = uniqueNames[i_unique].toLowerCase().trim();
							var index_replac_style = index_uniqueLower.split(" ").join("_");
							$('#list_stili').append('<option class="elenco_stili" value=' + index_replac_style + '>' + uniqueNames[i_unique] + '</option>');
						}

						bind_accordion();

					});
					$(".loader").show();
					show_Modal_gare();
				});

			});

		}, 400);


		$("#myModalGare .close").click(function() {

