rules_version = '2';

// Regole di sicurezza di Firestore per Cloro.
// Il controllore (GitHub Actions) usa l'account di servizio, che non passa da queste regole.
service cloud.firestore {
  match /databases/{database}/documents {

    function registrato() {
      return request.auth != null;
    }

    // Chi gestisce Cloro: ha un documento in /admin col suo id (lo crea solo il controllore).
    function admin() {
      return request.auth != null && exists(/databases/$(database)/documents/admin/$(request.auth.uid));
    }

    // Avvisi pubblicati dal Comitato: pubblici in lettura, li scrive solo il controllore.
    match /posts/{id} {
      allow read: if true;
      allow write: if false;
    }

    // "Ultimo controllo" e riassunto degli avvisi: pubblici in lettura.
    match /meta/stato {
      allow read: if true;
      allow write: if false;
    }
    match /meta/avvisi {
      allow read: if true;
      allow write: if false;
    }

    // Elenchi delle gare: solo per chi ha fatto l'accesso (contengono nomi di atleti nelle pagine collegate).
    match /meta/gare-diretta {
      allow read: if registrato();
      allow write: if false;
    }
    match /meta/gare-italia {
      allow read: if registrato();
      allow write: if false;
    }

    // Tutto il resto di meta (indici e stato interni del controllore): lo legge solo l'admin.
    match /meta/{altro} {
      allow read: if admin();
      allow write: if false;
    }

    match /admin/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Consigli: ognuno manda i suoi e li rivede; l'admin li legge tutti, li segna e risponde.
    match /consigli/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'testo', 'tipo', 'dispositivo', 'stato', 'creato'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.testo is string
        && request.resource.data.testo.size() >= 3 && request.resource.data.testo.size() <= 1000
        && request.resource.data.tipo in ['idea', 'problema', 'altro']
        && request.resource.data.stato == 'nuovo'
        && request.resource.data.creato == request.time;
      allow read: if admin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stato', 'risposta'])
        && request.resource.data.stato in ['nuovo', 'letto', 'fatto'];
      allow delete: if admin();
    }

    // Annunci a tutti: li scrive l'admin, li manda il controllore.
    match /annunci/{id} {
      allow read: if admin();
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['titolo', 'corpo', 'stato', 'creato'])
        && request.resource.data.titolo is string && request.resource.data.titolo.size() <= 60
        && request.resource.data.corpo is string && request.resource.data.corpo.size() <= 180
        && request.resource.data.stato == 'da-inviare';
      allow update, delete: if false;
    }

    // Gare, risultati, schede atleta e indice di ricerca: solo per chi ha fatto l'accesso.
    match /gare/{gara} {
      allow read: if registrato();
      allow write: if false;
      match /categorie/{categoria} {
        allow read: if registrato();
        allow write: if false;
      }
    }
    match /atleti/{atleta} {
      allow read: if registrato();
      allow write: if false;
    }
    match /indici/{lettera} {
      allow read: if registrato();
      allow write: if false;
    }

    // Dati di lavoro del controllore.
    match /primati/{id} {
      allow read, write: if false;
    }
    match /stato-live/{id} {
      allow read, write: if false;
    }

    // Preferenze di ogni utente: le vede e le cambia solo lui.
    match /users/{uid} {
      function proprietario() {
        return request.auth != null && request.auth.uid == uid;
      }

      function valido(d) {
        return d.keys().hasOnly(['settori', 'gruppi', 'tipi', 'pushOn', 'tokens', 'seguiti', 'creato', 'aggiornato'])
          && d.settori is list && d.settori.size() <= 12
          && d.gruppi is list && d.gruppi.size() <= 2
          && d.tipi is list && d.tipi.size() <= 12
          && d.pushOn is bool
          && d.tokens is list && d.tokens.size() <= 20
          && (!('seguiti' in d) || (d.seguiti is list && d.seguiti.size() <= 10));
      }

      allow read: if proprietario() || admin();
      allow delete: if proprietario();
      allow create, update: if proprietario() && valido(request.resource.data);
    }
  }
}
