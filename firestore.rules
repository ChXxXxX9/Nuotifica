rules_version = '2';

// Regole di sicurezza di Firestore per Cloro.
// Il controllore (GitHub Actions) usa l'account di servizio, che non passa da queste regole.
service cloud.firestore {
  match /databases/{database}/documents {

    function registrato() {
      return request.auth != null;
    }

    // Chi gestisce Cloro: ha un documento in /admin col suo id (lo crea solo il controllore).
    function admin() {
      return request.auth != null && exists(/databases/$(database)/documents/admin/$(request.auth.uid));
    }

    // Avvisi pubblicati dal Comitato: pubblici in lettura, li scrive solo il controllore.
    match /posts/{id} {
      allow read: if true;
      allow write: if false;
    }

    // "Ultimo controllo" e riassunto degli avvisi: pubblici in lettura.
    match /meta/stato {
      allow read: if true;
      allow write: if false;
    }
    match /meta/avvisi {
      allow read: if true;
      allow write: if false;
    }

    // Elenchi delle gare: solo per chi ha fatto l'accesso (contengono nomi di atleti nelle pagine collegate).
    match /meta/gare-diretta {
      allow read: if registrato();
      allow write: if false;
    }
    match /meta/gare-italia {
      allow read: if registrato();
      allow write: if false;
    }
    match /meta/squadre {
      allow read: if registrato();
      allow write: if false;
    }

    // Tutto il resto di meta (indici e stato interni del controllore): lo legge solo l'admin.
    match /meta/{altro} {
      allow read: if admin();
      allow write: if false;
    }

    match /admin/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Consigli: ognuno manda i suoi e li rivede; l'admin li legge tutti, li segna e risponde.
    match /consigli/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'testo', 'tipo', 'dispositivo', 'stato', 'creato', 'rif'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.testo is string
        && request.resource.data.testo.size() >= 3 && request.resource.data.testo.size() <= 1000
        && request.resource.data.tipo in ['idea', 'problema', 'altro', 'errore']
        // "Segnala un errore" da un tempo o da una scheda: il riferimento a cosa non torna.
        && (!('rif' in request.resource.data) || (request.resource.data.rif is string && request.resource.data.rif.size() <= 200))
        && request.resource.data.stato == 'nuovo'
        && request.resource.data.creato == request.time;
      allow read: if admin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stato', 'risposta'])
        && request.resource.data.stato in ['nuovo', 'letto', 'fatto'];
      // Chi elimina l'account cancella anche i suoi Consigli.
      allow delete: if admin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    // "Sei questo atleta o un suo genitore?": chi è iscritto manda la richiesta per sé; la leggono e la
    // gestiscono solo l'admin e il controllore (che la segnala all'admin e, chiusa, ne cancella i dati).
    // L'admin può anche crearne una a mano (richiesta arrivata per email).
    match /richiestePrivacy/{id} {
      function richiestaValida(d) {
        return d.keys().hasOnly(['uid', 'atleta', 'nome', 'tipo', 'chi', 'prova', 'email', 'stato', 'creato', 'avvisato', 'manuale'])
          && d.uid == request.auth.uid
          && d.atleta is string && d.atleta.size() >= 3 && d.atleta.size() <= 80
          && d.nome is string && d.nome.size() <= 80
          && d.tipo in ['togli', 'solo-risultati']
          && d.chi in ['atleta', 'genitore']
          && d.prova is string && d.prova.size() <= 300
          && d.email is string && d.email.size() <= 120
          && d.stato == 'nuova'
          && d.avvisato is bool
          && d.creato == request.time;
      }
      allow create: if request.auth != null && richiestaValida(request.resource.data)
        && (admin() || (request.resource.data.avvisato == false && !('manuale' in request.resource.data)
          && request.resource.data.prova.size() >= 3 && request.resource.data.email.size() >= 5));
      allow read, delete: if admin();
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stato', 'chiusa'])
        && request.resource.data.stato in ['nuova', 'in-attesa', 'tolta', 'solo-risultati', 'respinta', 'scaduta'];
    }

    // Annunci a tutti: li scrive l'admin, li manda il controllore.
    match /annunci/{id} {
      allow read: if admin();
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['titolo', 'corpo', 'stato', 'creato', 'url'])
        && (!('url' in request.resource.data) || (request.resource.data.url is string && request.resource.data.url.size() <= 120 && request.resource.data.url.matches('^#/.*')))
        && request.resource.data.titolo is string && request.resource.data.titolo.size() <= 60
        && request.resource.data.corpo is string && request.resource.data.corpo.size() <= 180
        && request.resource.data.stato == 'da-inviare';
      allow update, delete: if false;
    }

    // Configurazione gestita dall'admin: categorie per età (config/categorie) e impronte degli atleti
    // nascosti (config/nascosti: solo impronte delle chiavi, mai nomi).
    match /config/{id} {
      allow read: if registrato();
      allow write: if admin();
    }

    // Dati riservati: elenchi degli atleti nascosti, in attesa, "solo risultati", segnali sugli account.
    // Li legge e li scrive solo l'admin (il controllore usa l'account di servizio).
    match /privato/{doc=**} {
      allow read, write: if admin();
    }

    // Lavori chiesti dall'admin al controllore (rileggere una stagione, una gara…).
    match /lavori/{id} {
      allow read: if admin();
      allow create: if admin() && request.resource.data.stato == 'da-fare'
        && request.resource.data.tipo in ['stagione', 'gara', 'prova', 'testi', 'nascondi'];
      allow update, delete: if false;
    }

    // Graduatorie del Lazio e Indice Cloro.
    // Richieste di classifiche nazionali o di altre regioni: le prepara il controllore.
    match /richieste/{id} {
      allow read, update, delete: if false;
      allow create: if registrato()
        && request.resource.data.keys().hasOnly(['st', 'v', 'c', 'sx', 'reg', 'cat', 'creato'])
        && request.resource.data.st is string && request.resource.data.st.matches('^((19|20)[0-9]{2}|tutte)$')
        && request.resource.data.v in [25, 50]
        && request.resource.data.c is string && request.resource.data.c.size() <= 8
        && request.resource.data.sx in ['M', 'F']
        && request.resource.data.reg is string && request.resource.data.reg.size() <= 3
        && request.resource.data.cat in ['tutte', 'EB', 'EA', 'R', 'R14', 'R1', 'R2', 'J', 'J1', 'J2', 'C', 'S']
        && id == request.resource.data.st + '-' + string(request.resource.data.v) + '-' + request.resource.data.c + '-'
          + request.resource.data.sx + '-' + request.resource.data.reg + '-' + request.resource.data.cat;
    }

    // Storico gara per gara: chi segue un atleta chiede di scaricarlo (il controllore poi cancella la richiesta).
    match /richiesteStorico/{k} {
      allow read, update, delete: if false;
      allow create: if registrato()
        && k.matches('^[a-z0-9-]{3,80}$')
        && request.resource.data.keys().hasOnly(['creato'])
        && request.resource.data.creato == request.time;
    }

    match /classifiche/{id} {
      allow read: if registrato();
      allow write: if false;
    }

    // Gare, risultati, schede atleta e indice di ricerca: solo per chi ha fatto l'accesso.
    match /gare/{gara} {
      allow read: if registrato();
      allow write: if false;
      match /categorie/{categoria} {
        allow read: if registrato();
        allow write: if false;
      }
    }
    match /atleti/{atleta} {
      allow read: if registrato();
      allow write: if false;
    }
    // Vecchi indici (non più usati dall'app): chiusi, il controllore li cancella.
    match /indici/{lettera} {
      allow read, write: if false;
    }

    // Ricerca degli atleti (due lettere per documento), squadre e testi dei documenti del Comitato.
    // Tutta Italia: migliori di ogni stagione "a pacchi" e indice di ricerca a tre lettere.
    match /pacchi/{pacco} {
      allow read, write: if false;
    }
    match /cerca/{prefisso} {
      allow read, write: if false;
    }

    match /ricerca/{prefisso} {
      allow read: if registrato();
      allow write: if false;
    }
    match /squadre/{squadra} {
      allow read: if registrato();
      allow write: if false;
      match /stagioni/{stagione} {
        allow read: if registrato();
        allow write: if false;
      }
    }
    // Testi dei PDF del Comitato (contengono nomi): li usa solo il controllore per gli avvisi.
    match /testi/{documento} {
      allow read: if admin();
      allow write: if false;
    }
    // Tempi limite: li scrive l'admin (anche dal computer), li leggono tutti gli iscritti.
    match /limiti/{limite} {
      allow read: if registrato();
      allow create, update: if admin()
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 80
        && request.resource.data.vasca in [25, 50]
        && request.resource.data.t is map && request.resource.data.t.size() <= 400
        && request.resource.data.stato in ['bozza', 'da-notificare', 'pubblicato'];
      allow delete: if admin();
    }

    // Dati di lavoro del controllore.
    match /primati/{id} {
      allow read, write: if false;
    }
    match /stato-live/{id} {
      allow read, write: if false;
    }

    // Preferenze di ogni utente: le vede e le cambia solo lui.
    match /users/{uid} {
      function proprietario() {
        return request.auth != null && request.auth.uid == uid;
      }

      function valido(d) {
        return d.keys().hasOnly(['settori', 'gruppi', 'tipi', 'pushOn', 'tokens', 'th', 'seguiti', 'squadre', 'notSq', 'obiettivi', 'limiti', 'accettato', 'creato', 'aggiornato'])
          // Conferma dell'età e accettazione di Termini e Privacy: versione dei testi e ora.
          && (!('accettato' in d) || (d.accettato is map && d.accettato.keys().hasOnly(['v', 'eta', 'il'])
            && d.accettato.v is string && d.accettato.v.size() <= 20 && d.accettato.eta is bool && d.accettato.il is timestamp))
          && (!('th' in d) || (d.th is map && d.th.size() <= 20))
          && (!('squadre' in d) || (d.squadre is list && d.squadre.size() <= 10))
          && (!('notSq' in d) || (d.notSq is map && d.notSq.size() <= 10))
          && (!('obiettivi' in d) || (d.obiettivi is map && d.obiettivi.size() <= 60))
          && (!('limiti' in d) || (d.limiti is list && d.limiti.size() <= 10))
          && d.settori is list && d.settori.size() <= 12
          && d.gruppi is list && d.gruppi.size() <= 2
          && d.tipi is list && d.tipi.size() <= 12
          && d.pushOn is bool
          && d.tokens is list && d.tokens.size() <= 20
          && (!('seguiti' in d) || (d.seguiti is list && d.seguiti.size() <= 10));
      }

      allow read: if proprietario() || admin();
      allow delete: if proprietario();
      allow create, update: if proprietario() && valido(request.resource.data);
    }
  }
}
